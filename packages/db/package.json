{
  "name": "@app/db",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo \"@app/db schema ready\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
