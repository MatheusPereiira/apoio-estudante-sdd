# ==============================================================================
# Plataforma de Apoio ao Estudante Universitário — Variáveis de Ambiente (Exemplo)
# Constituição C4: NUNCA commitar .env com segredos reais!
# ==============================================================================

# Ambiente (development | test | staging | production)
NODE_ENV=development

# Banco de dados PostgreSQL 16 (deixe vazio para usar repositório InMemory com seeds @example.test)
DATABASE_URL=""

# Segurança e Autenticação (RNF07, RNF08)
JWT_SECRET="dev-only-change-in-production-min-32-chars-secret"
IP_HASH_SALT="dev-only-ip-salt-change-in-prod"
APP_VERSION="1.1.0"
TERMS_VERSION="2026-11"

# Rate Limiting (Upstash Redis — opcional em local, usa fallback em memória)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Observabilidade (Pino + Sentry — sendDefaultPii=false)
LOG_LEVEL="info"
SENTRY_DSN=""

# Chaves de LLM (SOMENTE no host do orquestrador do Harness — NUNCA no sandbox do agente!)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
