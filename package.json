{
  "name": "apoio-estudante-sdd",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "description": "Plataforma de Apoio ao Estudante Universitário — SDD + Agent Harness Engineering",
  "scripts": {
    "dev": "turbo run dev --filter=@app/web",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:domain": "turbo run test --filter=@app/domain",
    "test:integration": "turbo run test --filter=@app/infrastructure",
    "test:idor": "turbo run test:idor --filter=@app/infrastructure",
    "test:harness": "turbo run test --filter=@app/harness",
    "db:generate": "turbo run generate --filter=@app/db",
    "db:migrate": "turbo run migrate --filter=@app/db",
    "db:seed": "turbo run seed --filter=@app/db",
    "openapi:generate": "turbo run openapi --filter=@app/contracts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
